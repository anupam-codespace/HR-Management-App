<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvOtpDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Account Deletion"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="Enter the 6-digit verification code sent to your email to permanently delete your account:"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvOtpEmailTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#0056FD"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etOtpCode"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_otp_box"
        android:gravity="center"
        android:hint="• • • • • •"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:letterSpacing="0.4"
        android:maxLength="6"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOtpResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:padding="4dp"
        android:text="Resend code in 30s"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOtpCancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOtpVerifyDelete"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_delete_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Verify &amp; Delete"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
