  originalShiftName       String
  originalShiftStart      String
  originalShiftEnd        String

  reason                  String?
  status                  ShiftSwapStatus  @default(PENDING_EMPLOYEE)
  targetEmployeeResponse  String?          // ACCEPTED, REJECTED
  managerId               String?
  manager                 Employee?        @relation("ShiftSwapManager", fields: [managerId], references: [id])
  managerResponse         String?          // APPROVED, REJECTED
  approvedAt              DateTime?
  
  // Cancellation request flow
  cancellationRequested   Boolean          @default(false)
  cancellationReason      String?
  cancellationTargetAck   Boolean          @default(false)
  cancellationRequestedAt DateTime?

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  shiftAssignmentOverrides ShiftAssignmentOverride[]
  attendances              Attendance[]
}

model ShiftAssignmentOverride {
  id                   String         @id @default(uuid())
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
