  overrideShift        Shift?         @relation("OverrideShift", fields: [overrideShiftId], references: [id])
  source               OverrideSource @default(SHIFT_SWAP)
  relatedSwapRequestId String?
  relatedSwapRequest   ShiftSwapRequest? @relation(fields: [relatedSwapRequestId], references: [id], onDelete: Cascade)
  status               String         @default("ACTIVE") // ACTIVE, CANCELLED
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([employeeId, date])
}

