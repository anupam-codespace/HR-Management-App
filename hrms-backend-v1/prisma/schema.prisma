  year         Int
  currentValue Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([companyId, entityType, year])
  @@index([companyId])
}

model ManpowerRequisition {
  id                  String                    @id @default(uuid())
  companyId           String
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requisitionNumber   String

  departmentId        String
  department          Department                @relation(fields: [departmentId], references: [id])
  designationId       String
  designation         Designation               @relation(fields: [designationId], references: [id])

  requestedById       String
  requestedBy         Employee                  @relation("RequisitionRequester", fields: [requestedById], references: [id])

  positionsCount      Int                       @default(1)
  employmentType      RecruitmentEmploymentType @default(FULL_TIME)
  location            String?
  hiringReason        HiringReason              @default(NEW_POSITION)
  replacementForId    String?
  replacementFor      Employee?                 @relation("RequisitionReplacement", fields: [replacementForId], references: [id])

  requiredSkills      String[]                  @default([])
  minExperienceYears  Float                     @default(0)
  maxExperienceYears  Float?
  minSalary           Decimal?                  @db.Decimal(12, 2)
  maxSalary           Decimal?                  @db.Decimal(12, 2)
  currency            String                    @default("INR")
  expectedJoiningDate DateTime?
  justification       String?                   @db.Text

  // State machine snapshot
  status              RequisitionStatus         @default(DRAFT)
  isBudgeted          Boolean                   @default(true)
  budgetAmount        Decimal?                  @db.Decimal(12, 2)
  approvedById        String?
  approvedBy          Employee?                 @relation("RequisitionApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?

  updatedById         String?
  updatedBy           Employee?                 @relation("RequisitionUpdater", fields: [updatedById], references: [id])

  approvals           RequisitionApproval[]
  jobRequisitions     JobRequisition[]

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([companyId, requisitionNumber])
  @@index([companyId, status])
}

